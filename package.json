        "@tailwindcss/cli": "^4.1.0",
        "@tiptap/core": "3.31.3",
        "@tiptap/extension-image": "3.31.3",
        "@tiptap/pm": "3.31.3",
        "@tiptap/react": "3.31.3",
        "@tiptap/starter-kit": "3.31.3",
        "chart.js": "4.5.1",
        "chartjs-adapter-date-fns": "3.0.0",
        "date-fns": "4.4.0",
        "esbuild": "0.25.12",
        "filepond": "4.32.12",
        "filepond-plugin-file-poster": "2.5.2",
        "filepond-plugin-file-validate-size": "2.2.8",
